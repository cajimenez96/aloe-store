{
  "name": "aloe-store",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check": "bash scripts/check.sh",
    "check:fast": "bash scripts/check.sh --fast",
    "db:migrate": "npm run db:migrate --workspace @aloe/backend",
    "setup:store": "npm run setup:store --workspace @aloe/backend",
    "user:role": "npm run user:role --workspace @aloe/backend --",
    "email:preview": "npm run email:preview --workspace @aloe/backend"
  },
  "overrides": {
    "tsconfig-paths": "^4.2.0",
    "proxy-addr": "~2.0.8"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
