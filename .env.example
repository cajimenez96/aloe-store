# Aloe store - variables de entorno.
# Copiar a apps/backend/.env (backend) y apps/storefront/.env.local (storefront).
# Nunca subir valores reales al repositorio.

# --- Backend: base de datos y cache ---
# Con Docker Compose estas dos se sobrescriben con los nombres de servicio internos.
# Puertos del host: 5434 (postgres) y 6380 (redis) para no chocar con 5433/6379 de otros proyectos.
DATABASE_URL=postgres://aloe:aloe@localhost:5434/aloe_store
REDIS_URL=redis://localhost:6380

# --- Backend: seguridad ---
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# --- Backend: CORS ---
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9100
AUTH_CORS=http://localhost:8000,http://localhost:9100

# --- Backend: red ---
# Puerto del backend. 9000 lo usa otro contenedor local, por eso 9100.
PORT=9100
PUBLIC_BACKEND_URL=http://localhost:9100
# shared (desarrollo) | server | worker (produccion, ver arquitectura.md seccion 17)
MEDUSA_WORKER_MODE=shared

# --- Mercado Pago (credenciales de prueba fuera de produccion) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Almacenamiento S3 compatible (Cloudflare R2), bucket publico de imagenes ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=

# --- Email ---
EMAIL_PROVIDER_API_KEY=

# --- Storefront (apps/storefront/.env.local) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9100
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:8000
