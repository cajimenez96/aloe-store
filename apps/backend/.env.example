# Backend (Medusa). Copiar a apps/backend/.env para correr fuera de Docker.
# Lista completa de arquitectura.md, seccion 17.5. Nunca subir valores reales.

NODE_ENV=development
# server | worker. En local sin Docker se usa "shared" (un solo proceso).
MEDUSA_WORKER_MODE=shared
# false en el servidor, true en el worker.
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9100
# 9000 lo usa otro servicio en esta maquina, por eso 9100.
PORT=9100

# Con Docker Compose estas dos se sobrescriben con los nombres de servicio internos.
# Si el host no es localhost y la base no tiene SSL (desarrollo), agregar ?sslmode=disable.
DATABASE_URL=postgres://aloe:aloe@localhost:5434/aloe_store
REDIS_URL=redis://localhost:6380

# Generar con al menos 32 bytes aleatorios y distintos por entorno (seguridad.md, SEC-10).
JWT_SECRET=
COOKIE_SECRET=

# Dominios exactos, sin comodines (SEC-16).
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9100
AUTH_CORS=http://localhost:8000,http://localhost:9100

# Imagenes de producto (bucket publico de R2)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=https://imagenes.<dominio>

# Comprobantes de transferencia (bucket privado de R2, credenciales propias)
PROOFS_S3_BUCKET=
PROOFS_S3_ACCESS_KEY_ID=
PROOFS_S3_SECRET_ACCESS_KEY=

# Mercado Pago (credenciales de prueba fuera de produccion)
MP_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
