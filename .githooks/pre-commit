#!/usr/bin/env bash
# Bloquea el commit de archivos .env y de patrones de claves (seguridad.md, SEC-10).
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# 1. Archivos .env (se permiten los de ejemplo).
while IFS= read -r file; do
  base=$(basename "$file")
  case "$base" in
    .env.example | .env.template) ;;
    .env | .env.*)
      echo "BLOQUEADO: $file es un archivo de entorno y no se versiona." >&2
      fail=1
      ;;
  esac
done <<< "$staged"

# 2. Patrones de claves en las lineas agregadas.
patterns='APP_USR-[0-9A-Za-z_-]{16,}|TEST-[0-9]{8,}-[0-9]{6}-[0-9a-f]{20,}|-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|sk_live_[0-9A-Za-z]{16,}|ghp_[0-9A-Za-z]{30,}|github_pat_[0-9A-Za-z_]{40,}'
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+[^+]' | grep -E -q "$patterns"; then
  echo "BLOQUEADO: se detecto un patron de clave o token en los cambios." >&2
  git diff --cached -U0 --diff-filter=ACM | grep -E '^\+[^+]' | grep -E -o "$patterns" | sed 's/^\(.\{8\}\).*/\1.../' >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "Si es un falso positivo, revisalo antes de forzar el commit." >&2
  exit 1
fi
